# 더 골프 환경변수 템플릿 — 실제 값은 .env 에 채워넣고 절대 커밋하지 말 것

# Neon PostgreSQL 연결 문자열 (pooler 엔드포인트 권장)
# 발급: Neon 대시보드 → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth 서명 키 — 32바이트 랜덤 hex
# 생성: openssl rand -hex 32   또는   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# 로컬: http://localhost:3005  /  배포: https://thegolfer.co.kr
NEXTAUTH_URL="http://localhost:3005"

# 메타데이터/sitemap/OG에서 절대 URL 기준 (Vercel에 필수 등록)
# 비워두면 NEXTAUTH_URL을 폴백으로 사용. 배포 환경에서는 명시 권장.
NEXT_PUBLIC_SITE_URL="http://localhost:3005"

# 밴드 크롤러용 (선택, 로컬에서 cron 테스트 안 하면 생략 가능)
# Anthropic 콘솔에서 발급
ANTHROPIC_API_KEY=""

# Vercel Cron 보호용 시크릿 — 32바이트 랜덤
# Vercel 환경변수에도 동일 값 등록 필요
CRON_SECRET=""

# 네이버 밴드 Open API (OAuth) — developers.band.us 에서 앱 등록 후 발급
BAND_CLIENT_ID=""
BAND_CLIENT_SECRET=""
# 로컬: http://localhost:3005/api/admin/band/oauth/callback
# 배포: https://thegolfer.co.kr/api/admin/band/oauth/callback
BAND_REDIRECT_URI="http://localhost:3005/api/admin/band/oauth/callback"

# Vercel Blob 이미지 호스팅 — 대시보드 Storage에서 Blob 스토어 생성 후 프로젝트 연결 시
# Vercel 환경변수에 자동 주입됨. 로컬 크롤/스크립트 테스트 시에만 .env에 수동 추가.
# 미설정 시 storeFromUrl이 원본 URL 그대로 폴백(이미지 안정성 미확보).
BLOB_READ_WRITE_TOKEN=""
