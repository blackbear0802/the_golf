# 더 골프 환경변수 템플릿 — 실제 값은 .env 에 채워넣고 절대 커밋하지 말 것

# Neon PostgreSQL 연결 문자열 (pooler 엔드포인트 권장)
# 발급: Neon 대시보드 → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth 서명 키 — 32바이트 랜덤 hex
# 생성: openssl rand -hex 32   또는   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# 로컬: http://localhost:3005  /  배포: https://the-golf-v2.vercel.app
NEXTAUTH_URL="http://localhost:3005"

# 밴드 크롤러용 (선택, 로컬에서 cron 테스트 안 하면 생략 가능)
# Anthropic 콘솔에서 발급
ANTHROPIC_API_KEY=""

# Vercel Cron 보호용 시크릿 — 32바이트 랜덤
# Vercel 환경변수에도 동일 값 등록 필요
CRON_SECRET=""
